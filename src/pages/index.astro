---
import "../styles/global.css";
import archivoBlackWoff2 from "@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url";
import Portfolio from "../portfolio/Portfolio";
import CookieConsent from "../components/chrome/CookieConsent";

const site = "https://theshakeabhi.github.io";
const title = "Abhishek Chandrasenan — Software Engineer";
const description =
  "Software engineer with 6 years across fintech, developer tools, and AI media. Most recently led FanPro Studio's AI media generation platform end to end. Work, writing, playground and entirely too many easter eggs.";
const ogImage = `${site}/og.png`;
const ogImageAlt =
  "ABHISHEK CHANDRASENAN — software engineer, Bengaluru. Brutalist mega type on cream with a red accent block.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- --color-cream; a meta tag cannot reference CSS custom properties -->
    <meta name="theme-color" content="#f5f1e8" />

    <!-- Pre-paint minimal-mode skin: reads the SAME localStorage
         "portfolio.tweaks" key owned by src/lib/prefs.tsx and sets
         data-minimal on <html> before first paint, so a stored pref
         never flashes the full-fat colors/type. prefs.tsx keeps the
         attribute (and theme-color) in sync after hydration. -->
    <script is:inline>
      try {
        var __tweaks = JSON.parse(
          localStorage.getItem("portfolio.tweaks") || "{}"
        );
        if (__tweaks && __tweaks.minimal === true) {
          document.documentElement.setAttribute("data-minimal", "");
          /* minimal --color-cream (paper); meta can't read CSS vars */
          var __tc = document.querySelector('meta[name="theme-color"]');
          if (__tc) __tc.setAttribute("content", "#fbfbf9");
        }
      } catch (_e) {
        /* storage unavailable — stay full-fat */
      }
    </script>

    <!-- Hero display face — preload to avoid FOUT on the mega headline -->
    <link
      rel="preload"
      href={archivoBlackWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Consent Mode v2, BASIC mode — gtag.js is NOT loaded here.
         Consent defaults to DENIED and the script tag is injected only
         after an explicit opt-in: immediately below when localStorage
         portfolio.consent === "accepted" (returning visitors), or from the
         CookieConsent island when ACCEPT is clicked. Declined/undecided
         visitors send ZERO requests to googletagmanager/google-analytics
         (no cookieless pings). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        wait_for_update: 0,
      });
      window.__loadGtag = function () {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        gtag("consent", "update", { analytics_storage: "granted" });
        gtag("js", new Date());
        gtag("config", "G-X8L7GJY3D8");
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-X8L7GJY3D8";
        document.head.appendChild(s);
      };
      try {
        if (localStorage.getItem("portfolio.consent") === "accepted") {
          window.__loadGtag();
        }
      } catch (_e) {
        /* storage unavailable — treat as undecided, load nothing */
      }
    </script>
  </head>
  <body>
    <Portfolio client:load />
    <!-- Own island, outside PointerProvider — keeps the normal OS cursor -->
    <CookieConsent client:idle />
  </body>
</html>
